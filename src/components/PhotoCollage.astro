---
// 5x2 grid of travel photos for the Photography section, tiles touching
// with no gap. Assets come from photo collage/ via
// scripts/build_photography_assets.py, which also derives the slug/label
// pairs below from each source filename.
interface Photo { slug: string; label: string; }
const photos: Photo[] = [
  { slug: 'amsterdam', label: 'Amsterdam, Netherlands' },
  { slug: 'beijing', label: 'Beijing, China' },
  { slug: 'dubrovnik', label: 'Dubrovnik, Croatia' },
  { slug: 'copenhagen', label: 'Copenhagen, Denmark' },
  { slug: 'mostar', label: 'Mostar, Bosnia and Herzegovina' },
  { slug: 'prague', label: 'Prague, Czech Republic' },
  { slug: 'san-francisco', label: 'San Francisco, California' },
  { slug: 'sedona', label: 'Sedona, Arizona' },
  { slug: 'split', label: 'Split, Croatia' },
  { slug: 'strasbourg', label: 'Strasbourg, France' },
];
---

<div class="collage">
  {
    photos.map((p) => (
      <div class="collage__cell" tabindex="0">
        <img src={`/assets/photography/${p.slug}.webp`} alt={p.label} loading="lazy" decoding="async" />
        <span class="collage__label">{p.label}</span>
      </div>
    ))
  }
</div>

<style>
  /* Tiles touch (no gap) so the grid reads as one collage, not ten separate
     cards. Fixed 5x2 to match the ten source photos exactly. */
  .collage {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(2, 1fr);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .collage__cell {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    outline-offset: -3px;
  }
  .collage__cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .collage__cell:hover img,
  .collage__cell:focus-visible img { transform: scale(1.06); }

  .collage__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.85rem;
    background: linear-gradient(to top, rgba(10, 9, 6, 0.72), transparent 65%);
    color: #fff;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.01em;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .collage__cell:hover .collage__label,
  .collage__cell:focus-visible .collage__label { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .collage__cell img { transition: none; }
  }

  /* Five touching columns get too thin on a phone-width screen — switch to
     two touching columns (five rows) instead of shrinking further. */
  @media (max-width: 40rem) {
    .collage {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(5, 1fr);
    }
  }
</style>
